# host
http://localhost:5000/api

# curl options
 --silent
# include response headers
# --include
# to ignore SSL when working with localhost
# --insecure
# to read a header(s) from a file.  File format should be like:

# authorization
# Header-Name: Header-Value
# e.g. Authorization: YOUR_AUTH_TOKEN_HERE
# -H @/path/to/file.txt

# headers
Accept: application/json;
Connection: keep-alive
Content-Type: application/json; charset=utf-8
User-Agent: VRC

# query
# PATCH /reference/c0968422-f97c-4394-b2cd-1595625fd0ef/name
# PATCH /reference/f543f50c-3214-4965-b5bd-e8014afe59d5/reference_type
PATCH /reference/f543f50c-3214-4965-b5bd-e8014afe59d5/collection_id

# body
# {
#     "name": "new reference block name"
# }

# {
#     "reference_type": "all"
# }
 
{
    "collection_id": "aede9957-7260-42d8-91fa-fb76e9ae91a5"
}



