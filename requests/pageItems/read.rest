# host
http://localhost:5000/api

# curl options
 --silent
# include response headers
# --include
# to ignore SSL when working with localhost
# --insecure
# to read a header(s) from a file.  File format should be like:

# authorization
# Header-Name: Header-Value
# e.g. Authorization: YOUR_AUTH_TOKEN_HERE
# -H @/path/to/file.txt

# headers
Accept: application/json;
Connection: keep-alive
Content-Type: application/json; charset=utf-8
User-Agent: VRC

# query
PATCH /move/field/3dd64935-b6a9-4567-8bc4-62d755be95a1/to/collection/aede9957-7260-42d8-91fa-fb76e9ae91a5

# body
# {
#     "name": "Test2 url label",
#     "label": "Test2 url label",
#     "value": "https://google.com"
# }
