# host
http://localhost:5000/services

# curl options
 --silent
# include response headers
# --include
# to ignore SSL when working with localhost
# --insecure
# to read a header(s) from a file.  File format should be like:

# authorization
# Header-Name: Header-Value
# e.g. Authorization: YOUR_AUTH_TOKEN_HERE
# -H @/path/to/file.txt

# headers
Accept: application/json;
Connection: keep-alive
Content-Type: application/json; charset=utf-8
User-Agent: VRC

# query
# GET /api/page/f9c8069a-f4b4-4d24-8b44-72337f552f2a
GET /api/page/f9c8069a-f4b4-4d24-8b44-72337f552f2a?type=table_block,reference_block

# body
# {
#     "name": "Test2 url label",
#     "label": "Test2 url label",
#     "value": "https://google.com"
# }

