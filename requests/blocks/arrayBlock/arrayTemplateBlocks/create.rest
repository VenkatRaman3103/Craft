# host
http://localhost:5000/api

# curl options
 --silent
# include response headers
# --include
# to ignore SSL when working with localhost
# --insecure
# to read a header(s) from a file.  File format should be like:

# authorization
# Header-Name: Header-Value
# e.g. Authorization: YOUR_AUTH_TOKEN_HERE
# -H @/path/to/file.txt

# headers
Accept: application/json;
Connection: keep-alive
Content-Type: application/json; charset=utf-8
User-Agent: VRC

# query
POST  /array/templates

# body
{
    "name": "hello world",
    "array_block_id": "9b8da32e-824c-4042-9900-e8c13e9fe8a5",
    "array_block_item_id": "9b8da32e-824c-4042-9900-e8c13e9fe8a5"
}
