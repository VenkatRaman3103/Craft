# host
http://localhost:5000/api

# curl options
 --silent
# include response headers
# --include
# to ignore SSL when working with localhost
# --insecure
# to read a header(s) from a file.  File format should be like:

# authorization
# Header-Name: Header-Value
# e.g. Authorization: YOUR_AUTH_TOKEN_HERE
# -H @/path/to/file.txt

# headers
Accept: application/json;
Connection: keep-alive
Content-Type: application/json; charset=utf-8
User-Agent: VRC

# query
POST  /array/templates

# body
{
    "name": "array template",
    "array_block_id": "00c2460e-c20f-4f56-a3b9-4125ea06748a",
    "array_block_item_id": "7aaad61d-3248-423c-8a6b-cc5bd28af3a6"
}
