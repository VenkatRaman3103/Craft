# host
http://localhost:5000/api

# curl options
 --silent
# include response headers
# --include
# to ignore SSL when working with localhost
# --insecure
# to read a header(s) from a file.  File format should be like:

# authorization
# Header-Name: Header-Value
# e.g. Authorization: YOUR_AUTH_TOKEN_HERE
# -H @/path/to/file.txt

# headers
Accept: application/json;
Connection: keep-alive
Content-Type: application/json; charset=utf-8
User-Agent: VRC

# query
# PATCH /array/templates/f13cbb67-4109-4e3f-9626-6d1e0f510baf/name
PATCH /array/templates/f13cbb67-4109-4e3f-9626-6d1e0f510baf/description

# body
{
    "description": "new description"
}
