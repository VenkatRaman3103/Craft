.project-list-container {
    width: 100%;
    height: 100%;
    min-height: fit-content;
    display: flex;
    flex-direction: row;
    align-items: start;
    justify-content: start;
    flex-wrap: wrap;
    gap: 20px;

    margin: 40px;

    .project-folder-continaer {
        height: 200px;
        width: 200px;
        background-color: var(--secondary-color);

        display: flex;
        flex-direction: column;
        justify-content: space-between;


        .project-folder-header {
            width: 100%;
            display: flex;
            justify-content: end;
        }

        .project-folder-body {
            padding: 10px;
        }
    }

    .project-folder-add {
        height: 200px;
        width: 200px;
        border: 1.5px solid var(--secondary-color);

        display: flex;
        align-items: center;
        justify-content: center;
    }
}

.add-project-popup-container {
    height: 200px;
    width: 200px;
    background-color: var(--secondary-color);

    position: absolute;
    left: 50%;
    top: 50%;

    transform: translateX(-50%) translateY(-50%);
    box-shadow: rgba(0, 0, 0, 0.2) 0px 18px 50px 100px;
}
